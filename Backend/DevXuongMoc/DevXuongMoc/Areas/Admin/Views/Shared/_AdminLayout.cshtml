<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DevXuongMoc Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            body { background: #f4f6f9; }
            .admin-header { height: 56px; }
            .admin-sidebar {
                width: 230px;
                min-height: calc(100vh - 56px);
                background: #ffffff;
                border-right: 1px solid #dee2e6;
            }
            .admin-sidebar .side-item {
                display: block;
                padding: .5rem .75rem;
                background: #ffffff;
                border: 1px solid #ced4da;
                border-radius: 4px;         
                color: #212529;
                text-decoration: none;
            }
            .admin-sidebar .side-item:hover {
                background: #e9ecef;
                border-color: #adb5bd;
            }
            .admin-sidebar .side-item.disabled {
                color: #adb5bd;
                background: #f8f9fa;
                border-color: #e9ecef;
                pointer-events: none;     
            }
            .admin-sidebar .nav-heading {
                color: black;
                font-size: .75rem;
                text-transform: uppercase;
                padding: .5rem .25rem 0;
            }

            .nav-link {
                background-color: #f3f3f3;
            }

            .nav-link.disabled {
                background-color: #f3f3f3;
            }
    </style>
</head>
<body>

    @* header *@
    <div class="admin-header navbar navbar-light bg-white border-bottom px-3">
        <a class="navbar-brand fw-bold text-dark" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            DevXuongMoc Admin
        </a>
        <div class="d-flex align-items-center gap-3 text-dark">
            <span>Xin chào, Admin</span>
            <a href="#" class="btn btn-sm btn-outline-dark disabled">Đăng xuất</a>
        </div>
    </div>

    <div class="d-flex">
        @* sidebar*@
        <partial name="_Sidebar" />

        @* nội dung *@
        <div class="flex-grow-1 p-4">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>